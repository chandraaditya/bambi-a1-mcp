{
  "name": "bambi-a1-mcp",
  "version": "0.2.3",
  "type": "module",
  "description": "Bambu A1 MCP: Bambu Studio slicing, verified LAN printing and cloud monitoring",
  "license": "GPL-2.0-only",
  "repository": { "type": "git", "url": "https://github.com/chandraaditya/bambi-a1-mcp.git" },
  "homepage": "https://github.com/chandraaditya/bambi-a1-mcp#readme",
  "bugs": "https://github.com/chandraaditya/bambi-a1-mcp/issues",
  "files": ["src", "scripts", "examples", "docs", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "os": ["darwin", "linux"],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bambi-a1-mcp": "src/server.mjs",
    "bambi": "scripts/bambi.mjs",
    "bambi-setup": "scripts/setup.mjs",
    "bambi-install-runtime": "scripts/install-runtime.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "bambi": "node scripts/bambi.mjs",
    "setup": "node scripts/setup.mjs",
    "install:runtime": "node scripts/install-runtime.mjs",
    "import:session": "node scripts/import-studio-session.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "bambu-printer-mcp": "1.1.51",
    "mqtt": "5.16.1"
  }
}
